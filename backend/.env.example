# Sao chép file này thành backend/.env và điền giá trị thật. KHÔNG commit file .env.

# MongoDB (Atlas hoặc local)
MONGODB_URL=mongodb+srv://<username>:<password>@<cluster-host>/customer_analytics_db?retryWrites=true&w=majority
MONGODB_DB_NAME=customer_analytics_db

# API server
API_PORT=8000
API_HOST=0.0.0.0

# JWT — tạo khóa bằng: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=120

# CORS — danh sách origin frontend hợp lệ, phân tách bằng dấu phẩy
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
